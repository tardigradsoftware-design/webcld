# ============================================================
# Tardigrad Software — Ortam Değişkenleri
# Bu dosya örnektir; gerçek değerlerle .env.local oluşturun.
# .env.local git'e commit edilmez.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (e-posta)
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@tardigradsoftware.com
RESEND_TO_EMAIL=info@tardigradsoftware.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://tardigradsoftware.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+905XXXXXXXXX
NEXT_PUBLIC_PHONE=+90216XXXXXXX

# Sitemap doğrulama uç noktası (opsiyonel)
SITEMAP_PING_TOKEN=
